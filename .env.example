# Copy to .env.local and fill in. These values are public by design (they ship in the browser bundle).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Production backend address; leave empty for local development (Vite proxies /api to 127.0.0.1:8000).
VITE_API_BASE_URL=
